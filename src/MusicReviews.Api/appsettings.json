{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "MusicReviews",
    "Audience": "MusicReviews.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "MusicBrainz": {
    "BaseUrl": "https://musicbrainz.org/ws/2/",
    "CoverArtBaseUrl": "https://coverartarchive.org/",
    "//UserAgent": "MusicBrainz exige identificar la app y dar una via de contacto; sin esto responde 403. Cambia la URL por la de tu repo.",
    "UserAgent": "MusicReviews/0.1.0 ( https://github.com/CAMBIAR-USUARIO/MusicReviews )",
    "MinIntervalMilliseconds": 1100,
    "MaxRetries": 3,
    "TimeoutSeconds": 20,
    "CacheDays": 30,
    "SearchCacheMinutes": 10,
    "CoverArtSize": 500
  },
  "Avatars": {
    "//": "Carpeta de los avatares subidos. Fuera de wwwroot a proposito: ahi adentro se perderian en cada publicado. Se sirven bajo RequestPath con nosniff.",
    "StoragePath": "data/avatars",
    "RequestPath": "/avatars",
    "MaxSizeBytes": 2097152
  },
  "News": {
    "//": "Feeds de noticias. Se muestran titulo, extracto corto, imagen y enlace a la fuente: nada mas. Cambiar o vaciar esta lista no requiere recompilar; con la lista vacia la seccion no aparece.",
    "Feeds": [
      { "Name": "Pitchfork", "Url": "https://pitchfork.com/feed/feed-news/rss" },
      { "Name": "Stereogum", "Url": "https://www.stereogum.com/feed/" },
      { "Name": "Consequence", "Url": "https://consequence.net/feed/" }
    ],
    "RefreshMinutes": 30,
    "StaleHours": 24,
    "TimeoutSeconds": 8,
    "UserAgent": "MusicReviews/0.1.0 ( https://github.com/CAMBIAR-USUARIO/MusicReviews )"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/musicreviews-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
