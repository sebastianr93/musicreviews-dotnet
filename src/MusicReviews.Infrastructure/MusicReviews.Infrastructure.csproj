<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MusicReviews.Application\MusicReviews.Application.csproj" />
    <ProjectReference Include="..\MusicReviews.Domain\MusicReviews.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <!--
    Los tests de integracion necesitan volver a registrar la implementacion real de
    IAvatarStorage, que es internal. Se abre el assembly a ese proyecto en vez de hacer
    publica la clase: el tipo sigue siendo un detalle de infraestructura, y quien lo
    necesita es la suite, no los consumidores de la biblioteca.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="MusicReviews.IntegrationTests" />
  </ItemGroup>

  <!-- Necesario para que 'dotnet ef migrations add' pueda generar migraciones en este proyecto. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
