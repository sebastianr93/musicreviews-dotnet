# Variables del servicio en produccion. No es un archivo que se lea: es la lista de lo
# que hay que cargar en el panel de la plataforma. Los valores reales no van al repo.
#
# En ASP.NET Core el doble guion bajo separa niveles de la configuracion:
# Jwt__SigningKey equivale a { "Jwt": { "SigningKey": ... } }.

ASPNETCORE_ENVIRONMENT=Production

# La base. La plataforma (Neon, Railway, Render, Supabase) publica una sola URL con
# formato postgres://usuario:clave@host/base — se pega tal cual, la aplicacion la traduce.
DATABASE_URL=

# Clave de firma de los tokens. Minimo 32 caracteres, aleatoria, distinta por entorno.
# Generarla con: openssl rand -base64 48
Jwt__SigningKey=

# Cuenta de administrador inicial. Sin estas tres variables no se crea ninguna: no hay
# usuario por defecto con contraseña conocida.
SeedAdmin__UserName=
SeedAdmin__Email=
SeedAdmin__Password=

# Contenido de demostracion. Se siembra una sola vez, en segundo plano, la primera vez
# que arranca contra una base vacia. La contraseña es la de las cuentas publicas de
# prueba: se puede compartir, es a proposito.
Demo__Enabled=true
Demo__Password=

# Identificacion ante MusicBrainz. Exigen nombre de aplicacion y una via de contacto;
# sin esto responden 403.
MusicBrainz__UserAgent=MusicReviews/1.0.0 ( https://github.com/sebastianr93/musicreviews-dotnet )
News__UserAgent=MusicReviews/1.0.0 ( https://github.com/sebastianr93/musicreviews-dotnet )

# Apagar solo si la plataforma ya redirige a https en el borde y no manda
# X-Forwarded-Proto: en ese caso la redireccion de la aplicacion es un bucle.
Hosting__HttpsRedirection=true
